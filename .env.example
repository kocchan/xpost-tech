# xpost-tech ローカル実行用環境変数
# このファイルを `.env` にコピーして値を埋めて使う:
#   cp .env.example .env
#
# .env は .gitignore で除外されているので、コミットされない。
# GitHub Actions では同名の Secrets が自動的に渡されるので .env は不要。

# ─────────────────────────────────────────
# X (Twitter) 認証 Cookie
# ─────────────────────────────────────────
# ブラウザで X にログイン → DevTools → Application → Cookies → https://x.com
# 以下 2 つの値をコピー。数週間〜数ヶ月で失効するので失効時は再取得して書き換える。
X_AUTH_TOKEN=
X_CT0=

# ─────────────────────────────────────────
# Claude API
# ─────────────────────────────────────────
# https://console.anthropic.com/settings/keys で発行
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────
# Slack 通知
# ─────────────────────────────────────────
# モード A (推奨): Bot Token モード
# メインツイートを親メッセージ、スレッド継続を Slack スレッド返信欄に投稿する。
# X のスレッド投稿用にコピペするのが楽になる。
# 設定手順:
#   1. https://api.slack.com/apps → Create New App → From scratch
#   2. OAuth & Permissions → Bot Token Scopes に `chat:write` を追加
#   3. Install to Workspace → "Bot User OAuth Token" (xoxb- で始まる) をコピー
#   4. 投稿先チャンネルで `/invite @アプリ名` で Bot を招待
#   5. チャンネル名右クリック → View channel details → 最下部の Channel ID をコピー
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# モード B (フォールバック): Incoming Webhook
# Bot Token が無いときに使う。1 リライト = 1 メッセージ (スレッド機能なし)。
# 既に ~/.claude/skills/x-post-drafter/slack.json の webhook_url を使い回しても OK
# (notify_slack.py はそちらも自動検出する)
SLACK_WEBHOOK_URL=
